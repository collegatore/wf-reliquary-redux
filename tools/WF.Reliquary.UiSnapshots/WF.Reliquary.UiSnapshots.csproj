<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dev tool: renders the real Presentation views off-screen (Avalonia headless +
       Skia) with stand-in data and saves PNGs. Not shipped. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Keep in step with the app's Avalonia version. -->
    <PackageReference Include="Avalonia.Headless" Version="12.0.5" />
    <PackageReference Include="Avalonia.Skia" Version="12.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Presentation\WF.Reliquary.Presentation\WF.Reliquary.Presentation.csproj" />
  </ItemGroup>
</Project>
