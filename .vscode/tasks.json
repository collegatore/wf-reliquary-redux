{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "dotnet: restore",
      "type": "process",
      "command": "dotnet",
      "args": [
        "restore"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: build",
      "type": "process",
      "command": "dotnet",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: test",
      "type": "process",
      "command": "dotnet",
      "args": [
        "test"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: run presentation",
      "type": "process",
      "command": "dotnet",
      "args": [
        "run",
        "--project",
        "src/Presentation/WF.Reliquary.Presentation/WF.Reliquary.Presentation.csproj"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: clean",
      "type": "process",
      "command": "dotnet",
      "args": [
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: force clean (bin + obj)",
      "type": "shell",
      "command": "Get-ChildItem -Path . -Include bin,obj -Recurse -Directory | Remove-Item -Recurse -Force",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "powershell.exe",
          "args": ["-NonInteractive", "-Command"]
        }
      },
      "problemMatcher": []
    },
    {
      "label": "dotnet: publish (self-contained)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "publish",
        "src/Presentation/WF.Reliquary.Presentation/WF.Reliquary.Presentation.csproj",
        "-c", "Release",
        "-r", "win-x64",
        "--self-contained",
        "-p:PublishSingleFile=true"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": "$msCompile"
    },
    {
      "label": "dotnet: start presentation (no build)",
      "type": "process",
      "command": "dotnet",
      "args": [
        "WF.Reliquary.Presentation.dll"
      ],
      "options": {
        "cwd": "${workspaceFolder}/src/Presentation/WF.Reliquary.Presentation/bin/Debug/net10.0"
      },
      "problemMatcher": []
    }
  ]
}
