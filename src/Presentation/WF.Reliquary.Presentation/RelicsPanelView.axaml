<UserControl
    x:Class="WF.Reliquary.Presentation.RelicsPanelView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WF.Reliquary.Presentation">

  <!-- The Verbatim card DataTemplate is application-scoped (see App.axaml) so the
       rewards modal can also host it via a plain ContentControl. -->

  <!-- Compact card template — explicitly keyed (WishlistRelicCardViewModel's
       implicit template, app-scoped, is the Verbatim one) and set as the
       ItemTemplate on the Compact ItemsControl below. Keeps the card border,
       clipped header + ⋮ flyout, width scaling, and vaulted styling; the body
       is a flat list of reward lines with a bold tier letter marker in place
       of tier group headings. -->
  <UserControl.Resources>
    <DataTemplate x:Key="CompactRelicCardTemplate" DataType="{x:Type local:WishlistRelicCardViewModel}">
      <Border
          Margin="8"
          Padding="12"
          BorderBrush="Gray"
          BorderThickness="1"
          CornerRadius="4"
          Width="{DynamicResource RelicCardWidth}"
          Classes.vaulted="{Binding IsVaulted}">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TextBlock
                Grid.Column="0"
                FontWeight="SemiBold"
                Text="{Binding CompactRelicName}"
                TextWrapping="Wrap"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="1"
                Margin="4,0,0,0"
                Padding="6,2"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                FontWeight="Bold"
                Content="⋮">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight" HorizontalOffset="25" FlyoutPresenterClasses="app-menu">
                  <MenuItem
                      Header="Compose Recruiting Chat message…"
                      Command="{Binding ComposeCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <!-- Flat reward lines (no per-tier label rows). Each line leads with a
               bold tier letter marker instead of a group heading. -->
          <ItemsControl ItemsSource="{Binding Rewards}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:WishlistRelicRewardViewModel}">
                <TextBlock Margin="0,0,0,2" TextWrapping="Wrap" Classes.dimmed="{Binding IsDimmed}">
                  <Run Text="{Binding TierLetter}" FontWeight="Bold" />
                  <Run Text=" " />
                  <Run Text="{Binding CompactName}" />
                </TextBlock>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <!-- Control bar stack (Auto) above the relic-cards scroll (*). -->
  <Grid RowDefinitions="Auto,*">

    <!-- Control bar: Relics heading, Filters and Display menus, sort controls. -->
    <StackPanel Grid.Row="0">

      <!-- Relics control bar: "Relics" heads the relic-cards pane beneath it.
           Look comes from Styles/ControlBars.axaml. -->
      <Border Classes="control-bar">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="section-heading" Text="Relics" />

          <!-- Filters: what to hide. Checked entries hide; the funnel takes the
               selection accent (non-default) while anything is hidden. -->
          <Button
              Classes="dropdown-field icon-only"
              Classes.non-default="{Binding WishlistRelics.IsFilterActive}"
              ToolTip.Tip="{Binding WishlistRelics.FilterSummary}">
            <PathIcon Data="{StaticResource Icon.Funnel}" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="app-menu">
                <MenuItem Classes="menu-caption" Header="Hide" IsEnabled="False" />
                <MenuItem
                    Header="Vaulted"
                    ToggleType="CheckBox"
                    StaysOpenOnClick="True"
                    IsChecked="{Binding WishlistRelics.HideVaulted, Mode=TwoWay}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <!-- Sort: mode (fixed double-arrow icon, never changes; the mode itself is in
               the menu and the tooltip) and direction (the only icon that flips), kept
               tighter than the bar's spacing. -->
          <StackPanel Orientation="Horizontal" Spacing="4">
            <Button
                Classes="dropdown-field icon-only"
                Classes.non-default="{Binding WishlistRelics.IsSortNonDefault}"
                ToolTip.Tip="{Binding WishlistRelics.SortSummary}">
              <PathIcon Data="{StaticResource Icon.Sort}" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="app-menu">
                  <MenuItem Classes="menu-caption" Header="Sort by" IsEnabled="False" />
                  <MenuItem
                      Header="Era"
                      ToggleType="Radio"
                      GroupName="RelicSortMode"
                      IsChecked="{Binding WishlistRelics.SortMode, Mode=TwoWay, Converter={x:Static local:EnumToBoolConverter.Instance}, ConverterParameter=Era}" />
                  <MenuItem
                      Header="Alphabetical"
                      ToggleType="Radio"
                      GroupName="RelicSortMode"
                      IsChecked="{Binding WishlistRelics.SortMode, Mode=TwoWay, Converter={x:Static local:EnumToBoolConverter.Instance}, ConverterParameter=Alphabetical}" />
                  <MenuItem
                      Header="Wishlist score"
                      ToggleType="Radio"
                      GroupName="RelicSortMode"
                      IsChecked="{Binding WishlistRelics.SortMode, Mode=TwoWay, Converter={x:Static local:EnumToBoolConverter.Instance}, ConverterParameter=WishlistScore}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            <Button
                Classes="dropdown-field icon-only"
                Command="{Binding WishlistRelics.ToggleSortDirectionCommand}"
                ToolTip.Tip="{Binding WishlistRelics.SortSummary}">
              <Panel>
                <PathIcon Data="{StaticResource Icon.SortDescending}" IsVisible="{Binding WishlistRelics.SortDescending}" />
                <PathIcon Data="{StaticResource Icon.SortAscending}" IsVisible="{Binding !WishlistRelics.SortDescending}" />
              </Panel>
            </Button>
          </StackPanel>

          <!-- Display: how relics are shown (view mode, Show all rewards). -->
          <Button
              Classes="dropdown-field icon-only"
              Classes.non-default="{Binding WishlistRelics.IsDisplayNonDefault}"
              ToolTip.Tip="{Binding WishlistRelics.DisplaySummary}">
            <PathIcon Data="{StaticResource Icon.Eye}" />
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="app-menu">
                <MenuItem Classes="menu-caption" Header="View" IsEnabled="False" />
                <MenuItem
                    Header="Verbatim"
                    ToggleType="Radio"
                    GroupName="RelicViewMode"
                    IsChecked="{Binding WishlistRelics.ViewMode, Mode=TwoWay, Converter={x:Static local:EnumToBoolConverter.Instance}, ConverterParameter=Verbatim}" />
                <MenuItem
                    Header="Compact"
                    ToggleType="Radio"
                    GroupName="RelicViewMode"
                    IsChecked="{Binding WishlistRelics.ViewMode, Mode=TwoWay, Converter={x:Static local:EnumToBoolConverter.Instance}, ConverterParameter=Compact}" />
                <MenuItem
                    Header="Table"
                    ToggleType="Radio"
                    GroupName="RelicViewMode"
                    IsChecked="{Binding WishlistRelics.ViewMode, Mode=TwoWay, Converter={x:Static local:EnumToBoolConverter.Instance}, ConverterParameter=Table}" />
                <Separator />
                <!-- Card modes only: greyed out (state kept) in Table mode. -->
                <MenuItem
                    Header="Show all rewards"
                    ToggleType="CheckBox"
                    StaysOpenOnClick="True"
                    IsEnabled="{Binding !WishlistRelics.IsViewModeTable}"
                    IsChecked="{Binding WishlistRelics.ShowAllRewards, Mode=TwoWay}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <!-- In-content busy indicator for the Relics/Missions reload. -->
          <TextBlock
              Text="Updating…"
              Opacity="0.7"
              FontStyle="Italic"
              VerticalAlignment="Center"
              IsVisible="{Binding WishlistRelics.IsBusy}" />
        </StackPanel>
      </Border>

    </StackPanel>

    <!-- Row 1 hosts the per-view-mode subtrees as siblings, toggled by IsViewMode*.
         The two card modes share one ScrollViewer (they scroll their WrapPanel); the
         Table mode's TreeDataGrid scrolls itself, so it sits beside the ScrollViewer
         rather than inside it. -->
    <Panel Grid.Row="1">

      <!-- Card modes (Verbatim / Compact) -->
      <ScrollViewer IsVisible="{Binding !WishlistRelics.IsViewModeTable}">
        <StackPanel>
          <TextBlock
              Margin="8,16"
              IsVisible="{Binding WishlistRelics.IsEmpty}"
              Text="Add items to your wishlist to see relics here." />

          <!-- Verbatim mode -->
          <ItemsControl
              ItemsSource="{Binding WishlistRelics.Cards}"
              IsVisible="{Binding WishlistRelics.IsViewModeVerbatim}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>

          <!-- Compact mode -->
          <ItemsControl
              ItemsSource="{Binding WishlistRelics.Cards}"
              ItemTemplate="{StaticResource CompactRelicCardTemplate}"
              IsVisible="{Binding WishlistRelics.IsViewModeCompact}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

      <!-- Table mode: source (columns + hierarchy) is built in code-behind. -->
      <TreeDataGrid
          x:Name="RelicsTable"
          Margin="8,0"
          ShowColumnHeaders="False"
          IsVisible="{Binding WishlistRelics.IsViewModeTable}" />
    </Panel>

  </Grid>
</UserControl>
