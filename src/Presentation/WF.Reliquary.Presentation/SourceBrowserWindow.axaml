<Window
    x:Class="WF.Reliquary.Presentation.SourceBrowserWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Stored Sources"
    Width="650"
    Height="350"
    CanResize="True"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <DockPanel Margin="16">
    <Grid DockPanel.Dock="Top" ColumnDefinitions="*,2*,*" Margin="0,0,0,4">
      <TextBlock Grid.Column="0" FontWeight="SemiBold" Text="Version" />
      <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Source" Margin="8,0,0,0" />
      <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Downloaded" Margin="8,0,0,0" />
    </Grid>
    <ScrollViewer>
      <ItemsControl x:Name="SourcesList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="*,2*,*" Margin="0,2">
              <TextBlock Grid.Column="0" Text="{Binding LastUpdate}" TextTrimming="CharacterEllipsis" />
              <TextBlock Grid.Column="1" Text="{Binding SourceUrl}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0" />
              <TextBlock Grid.Column="2" Text="{Binding DownloadedAtFormatted}" Margin="8,0,0,0" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</Window>
