<Window
    x:Class="WF.Reliquary.Presentation.ConfirmClearImportDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Clear imported data?"
    Width="360"
    Height="140"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="20">
    <TextBlock
        TextWrapping="Wrap"
        VerticalAlignment="Center"
        Text="This will delete all imported drop-table data. You will need to re-import data to continue using the app. Continue?" />
    <StackPanel
        Grid.Row="1"
        Margin="0,12,0,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal"
        Spacing="8">
      <Button
          x:Name="ConfirmButton"
          Padding="14,6"
          Content="Confirm" />
      <Button
          x:Name="CancelButton"
          Padding="14,6"
          Content="Cancel" />
    </StackPanel>
  </Grid>
</Window>
