<UserControl
    x:Class="WF.Reliquary.Presentation.RelicsMissionsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WF.Reliquary.Presentation">

  <!-- ═══════════════════════════════════════════════════════════════════════
       MISSION CARD TEMPLATE — the relic card templates live in RelicsPanelView,
       which owns the (shared) relics panel content for both layouts.
       ═══════════════════════════════════════════════════════════════════════ -->
  <UserControl.DataTemplates>

    <DataTemplate DataType="{x:Type local:WishlistFarmingMissionGroupCardViewModel}">
      <Border
          Margin="8"
          Padding="12"
          BorderBrush="Gray"
          BorderThickness="1"
          CornerRadius="4"
          Width="{DynamicResource MissionCardWidth}">
        <StackPanel>

          <!-- Card header: mission type title + effective chance -->
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TextBlock
                Grid.Column="0"
                FontWeight="SemiBold"
                Text="{Binding GroupTitle}"
                TextWrapping="Wrap" />
            <TextBlock
                Grid.Column="1"
                Margin="8,0,0,0"
                FontWeight="SemiBold"
                Text="{Binding FormattedEffectiveChance}"
                VerticalAlignment="Top" />
          </Grid>
          <Separator Margin="0,0,0,6" />

          <!-- Nodes: member mission names (regular font), followed by a divider -->
          <TextBlock
              Margin="0,0,0,6"
              Text="{Binding NodesLabel}"
              TextWrapping="Wrap" />
          <Separator Margin="0,0,0,6" />

          <!-- Non-rotation: flat relic list (detailed) or compact row -->
          <StackPanel IsVisible="{Binding !HasRotations}">
            <ItemsControl
                ItemsSource="{Binding Relics}"
                IsVisible="{Binding ShowExactDropChances}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:WishlistFarmingMissionRelicViewModel}">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Grid.Column="0"
                        Text="{Binding RelicName}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Text="{Binding FormattedChance}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock
                Text="{Binding CompactRelicNames}"
                TextWrapping="Wrap"
                IsVisible="{Binding !ShowExactDropChances}" />
          </StackPanel>

          <!-- Rotation missions: per-rotation sections -->
          <ItemsControl
              ItemsSource="{Binding Rotations}"
              IsVisible="{Binding HasRotations}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:WishlistFarmingRotationViewModel}">
                <StackPanel Margin="0,0,0,4">
                  <!-- Rotation header: label + cumulative chance (always visible) -->
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock
                        Grid.Column="0"
                        FontStyle="Italic"
                        Text="{Binding RotationLabel}" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        FontStyle="Italic"
                        Text="{Binding FormattedCumulativeChance}" />
                  </Grid>
                  <!-- Relics within this rotation: detailed rows -->
                  <ItemsControl
                      ItemsSource="{Binding Relics}"
                      Margin="12,2,0,0"
                      IsVisible="{Binding ShowExactDropChances}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="{x:Type local:WishlistFarmingMissionRelicViewModel}">
                        <Grid ColumnDefinitions="*,Auto">
                          <TextBlock
                              Grid.Column="0"
                              Text="{Binding RelicName}"
                              TextWrapping="Wrap" />
                          <TextBlock
                              Grid.Column="1"
                              Margin="8,0,0,0"
                              Text="{Binding FormattedChance}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <!-- Relics within this rotation: compact row -->
                  <TextBlock
                      Margin="12,2,0,0"
                      Text="{Binding CompactRelicNames}"
                      TextWrapping="Wrap"
                      IsVisible="{Binding !ShowExactDropChances}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </Border>
    </DataTemplate>

  </UserControl.DataTemplates>

  <!-- Outer wrapper: the two layout subtrees overlap in one cell, toggled by
       visibility. The orientation switch lives in Settings (Appearance). -->
  <Grid Margin="0,12,0,0">

    <!-- ═══════════════════════════════════════════════════════════════════
         STACKED LAYOUT (existing; hidden when side-by-side is active)
         ═══════════════════════════════════════════════════════════════════ -->
    <Grid
        x:Name="RelicsMissionsGrid"
        RowDefinitions="*,4,*"
        IsVisible="{Binding IsStacked}">

      <!-- Row 0: Relics region — the shared relics panel with the missions
           separator pinned to its bottom. The splitter resizes this whole
           region against the missions scroll; the separator (Auto) stays fixed
           and the panel's internal scroll absorbs the change. -->
      <Grid Grid.Row="0" RowDefinitions="*,Auto">
        <local:RelicsPanelView x:Name="StackedRelicsPanel" Grid.Row="0" />

        <!-- Missions separator panel (pinned to bottom of relics section).
             Auto-sizes to its control row exactly like the Prime Gear filter bar;
             bottom corners are square where it meets the splitter. -->
        <Border
            Grid.Row="1"
            Classes="control-bar compact"
            Margin="8,4,8,0"
            CornerRadius="4,4,0,0">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="section-heading" Text="Missions" />
            <CheckBox
                Classes="chip"
                Content="Show exact drop chances"
                IsChecked="{Binding WishlistFarming.ShowExactDropChances}" />
          </StackPanel>
        </Border>
      </Grid>

      <!-- Row 1: GridSplitter -->
      <GridSplitter
          x:Name="RelicsSplitter"
          Grid.Row="1"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ResizeDirection="Rows"
          Background="#28808080">
        <GridSplitter.Styles>
          <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="#50808080" />
          </Style>
          <Style Selector="GridSplitter:pressed">
            <Setter Property="Background" Value="#70808080" />
          </Style>
        </GridSplitter.Styles>
      </GridSplitter>

      <!-- Row 2: Missions scroll -->
      <ScrollViewer Grid.Row="2" Margin="0,8,0,0">
        <StackPanel>
          <TextBlock
              Margin="8,16"
              IsVisible="{Binding WishlistFarming.IsEmpty}"
              Text="Add items to your wishlist to see farming missions here." />
          <ItemsControl ItemsSource="{Binding WishlistFarming.Cards}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>

    </Grid>
    <!-- end stacked layout -->

    <!-- ═══════════════════════════════════════════════════════════════════
         SIDE-BY-SIDE LAYOUT (hidden when stacked is active)
         Relics (col 0) MinWidth is set from code-behind (UpdateSideBySideMinWidth),
         derived from the current effective RelicCardWidth (config base × font-size
         ratio) + 2 × card margin (8), since card width is user-configurable and can
         no longer be a fixed literal. Missions (col 2) MinWidth stays the literal
         316 (RelicCardWidth's old fixed 300 + margin), since MissionCardWidth is
         not user-configurable. Relics (col 0) is a FIXED pixel column so it stays
         static on window resize; Missions (col 2) is the lone star column and
         absorbs all the slack. The GridSplitter drags the relics pixel width;
         code-behind persists/restores it (see SideBySideRelicsWidth). -->
    <Grid
        x:Name="SideBySideGrid"
        IsVisible="{Binding IsSideBySide}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="640" />
        <ColumnDefinition Width="4" />
        <ColumnDefinition Width="*" MinWidth="316" />
      </Grid.ColumnDefinitions>

      <!-- Column 0: shared relics panel (control bar + card scroll) -->
      <local:RelicsPanelView Grid.Column="0" />

      <!-- Column 1: Vertical GridSplitter -->
      <GridSplitter
          x:Name="SideBySideSplitter"
          Grid.Column="1"
          HorizontalAlignment="Stretch"
          VerticalAlignment="Stretch"
          ResizeDirection="Columns"
          Background="#28808080">
        <GridSplitter.Styles>
          <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="#50808080" />
          </Style>
          <Style Selector="GridSplitter:pressed">
            <Setter Property="Background" Value="#70808080" />
          </Style>
        </GridSplitter.Styles>
      </GridSplitter>

      <!-- Column 2: Missions panel (control bar + card scroll) -->
      <Grid Grid.Column="2" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Classes="control-bar">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Classes="section-heading" Text="Missions" />
            <CheckBox
                Classes="chip"
                Content="Show exact drop chances"
                IsChecked="{Binding WishlistFarming.ShowExactDropChances}" />
          </StackPanel>
        </Border>
        <ScrollViewer Grid.Row="1">
          <StackPanel>
            <TextBlock
                Margin="8,16"
                IsVisible="{Binding WishlistFarming.IsEmpty}"
                Text="Add items to your wishlist to see farming missions here." />
            <ItemsControl ItemsSource="{Binding WishlistFarming.Cards}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </Grid>

    </Grid>
    <!-- end side-by-side layout -->

  </Grid>
</UserControl>
