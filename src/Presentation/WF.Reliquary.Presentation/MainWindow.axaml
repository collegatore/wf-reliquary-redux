<Window
    x:Class="WF.Reliquary.Presentation.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="WF Reliquary Redux"
    Width="900"
    Height="600">
  <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="24">
    <TextBlock
        FontSize="24"
        FontWeight="SemiBold"
        Text="{Binding Title}" />
    <TextBlock
        Grid.Row="1"
        Margin="0,16,0,0"
        FontSize="16"
        Text="{Binding StatusText}"
        TextWrapping="Wrap" />
    <StackPanel
        Grid.Row="2"
        Margin="0,20,0,0"
        Spacing="8">
      <TextBlock Text="Drop-table source URL" />
      <TextBox
          MinWidth="560"
          Text="{Binding SourceUrlText, Mode=TwoWay}" />
      <Button
          Padding="14,8"
          HorizontalAlignment="Left"
          Command="{Binding SaveSourceUrlCommand}"
          Content="Save URL" />
    </StackPanel>
    <Button
        Grid.Row="3"
        Margin="0,20,0,0"
        Padding="14,8"
        HorizontalAlignment="Left"
        Command="{Binding DownloadCommand}"
        Content="Download drop tables" />
    <TextBlock
        Grid.Row="4"
        Margin="0,16,0,0"
        Text="{Binding OperationStatusText}"
        TextWrapping="Wrap" />
  </Grid>
</Window>
