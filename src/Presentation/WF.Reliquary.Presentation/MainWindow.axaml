<Window
    x:Class="WF.Reliquary.Presentation.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WF.Reliquary.Presentation"
    Title="WF Reliquary Redux"
    Width="900"
    Height="600">
  <Window.Styles>
    <Style Selector="Border.vaulted">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <Style Selector="TextBlock.ghost-part">
      <Setter Property="Foreground" Value="#C0A000" />
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <Style Selector="TextBlock.wishlisted">
      <Setter Property="FontWeight" Value="Bold" />
    </Style>
  </Window.Styles>
  <TabControl Margin="24">

    <TabItem Header="Drop Tables">
      <StackPanel Margin="0,12,0,0" Spacing="16">

        <!-- Section 1: Drop-table source URL -->
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="Drop-table source URL" />
          <TextBox
              MinWidth="560"
              Text="{Binding DropTables.SourceUrlText, Mode=TwoWay}" />
          <Button
              Padding="14,8"
              HorizontalAlignment="Left"
              Command="{Binding DropTables.SaveSourceUrlCommand}"
              IsEnabled="{Binding DropTables.CanSaveUrl}"
              Content="Save URL" />
        </StackPanel>

        <Separator />

        <!-- Section 2: File download -->
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="File download" />
          <TextBlock
              Text="{Binding DropTables.StatusText}"
              TextWrapping="Wrap" />
          <Button
              Padding="14,8"
              HorizontalAlignment="Left"
              Command="{Binding DropTables.DownloadCommand}"
              Content="Download drop tables" />
        </StackPanel>

        <Separator />

        <!-- Section 3: File import -->
        <StackPanel Spacing="8">
          <TextBlock FontWeight="SemiBold" Text="File import" />
          <TextBlock
              Text="{Binding DropTables.ImportStatusText}"
              TextWrapping="Wrap" />
          <Button
              Padding="14,8"
              HorizontalAlignment="Left"
              Command="{Binding DropTables.ImportCommand}"
              Content="Import stored file" />
        </StackPanel>

        <!-- Operation status (feedback for last action) -->
        <TextBlock
            Text="{Binding DropTables.OperationStatusText}"
            TextWrapping="Wrap" />

      </StackPanel>
    </TabItem>

    <TabItem Header="Prime Gear">
      <ScrollViewer Margin="0,12,0,0">
        <StackPanel>

          <!-- Wishlist selector row -->
          <Border
              Margin="8,0,8,8"
              Padding="12,8"
              Background="#1A808080"
              CornerRadius="4">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="Wishlist:" VerticalAlignment="Center" />
              <Button
                  x:Name="WishlistDropdownButton"
                  MinWidth="160"
                  Padding="10,6"
                  Background="Transparent"
                  BorderBrush="Gray"
                  BorderThickness="1"
                  Content="{Binding Wishlist.ActiveWishlistName}">
                <Button.Flyout>
                  <Flyout Placement="Bottom">
                    <StackPanel MinWidth="200" Spacing="0">

                      <!-- Existing wishlists -->
                      <ItemsControl ItemsSource="{Binding Wishlist.Wishlists}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type local:WishlistEntryViewModel}">
                            <Button
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Padding="12,6"
                                Command="{Binding SelectCommand}">
                              <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="✓" IsVisible="{Binding IsActive}" Width="14" />
                                <TextBlock Text=" " IsVisible="{Binding !IsActive}" Width="14" />
                                <TextBlock Text="{Binding Name}" />
                              </StackPanel>
                            </Button>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- Separator -->
                      <Separator Margin="0,4" />

                      <!-- Management actions -->
                      <Button
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Padding="12,6"
                          Command="{Binding Wishlist.RenameCommand}"
                          Content="Rename this list…" />
                      <Button
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Padding="12,6"
                          Command="{Binding Wishlist.DeleteCommand}"
                          IsEnabled="{Binding Wishlist.CanDelete}"
                          Content="Delete this list" />
                      <Button
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Padding="12,6"
                          Command="{Binding Wishlist.CreateCommand}"
                          Content="+ New list" />

                    </StackPanel>
                  </Flyout>
                </Button.Flyout>
              </Button>
              <Border Width="1" Background="Gray" Margin="4,0" VerticalAlignment="Stretch" />
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <CheckBox IsChecked="{Binding PrimeGear.ShowVaulted}" VerticalAlignment="Center" />
                <TextBlock Text="Show vaulted gear" VerticalAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>

          <!-- Active gear section -->
          <ItemsControl ItemsSource="{Binding PrimeGear.ActiveCards}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:PrimeGearCardViewModel}">
                <Border
                    Margin="8"
                    Padding="12"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="4"
                    Width="180">
                  <StackPanel Spacing="6">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding GearName}"
                        TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Parts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PrimePartViewModel}">
                          <Grid ColumnDefinitions="Auto,Auto,*">
                            <CheckBox
                                Grid.Column="0"
                                IsChecked="{Binding IsChecked}"
                                VerticalAlignment="Top" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="2,0,0,0"
                                IsVisible="{Binding IsGhost}"
                                Text="⚠"
                                VerticalAlignment="Center"
                                ToolTip.Tip="This part is not present in the current drop table import" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="4,0,0,0"
                                Text="{Binding PartName}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"
                                Classes.ghost-part="{Binding IsGhost}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

          <!-- Vaulted section header -->
          <Border
              Margin="8,8,8,0"
              Padding="12,8"
              Background="#1A808080"
              CornerRadius="4"
              IsVisible="{Binding PrimeGear.ShowVaulted}">
            <TextBlock FontWeight="SemiBold" Text="Vaulted" />
          </Border>

          <!-- Vaulted gear section -->
          <ItemsControl
              ItemsSource="{Binding PrimeGear.VaultedCards}"
              IsVisible="{Binding PrimeGear.ShowVaulted}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel Orientation="Horizontal" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:PrimeGearCardViewModel}">
                <Border
                    Margin="8"
                    Padding="12"
                    BorderBrush="Gray"
                    BorderThickness="1"
                    CornerRadius="4"
                    Width="180"
                    Opacity="0.55">
                  <StackPanel Spacing="6">
                    <TextBlock
                        FontWeight="SemiBold"
                        Text="{Binding GearName}"
                        TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Parts}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:PrimePartViewModel}">
                          <Grid ColumnDefinitions="Auto,Auto,*">
                            <CheckBox
                                Grid.Column="0"
                                IsChecked="{Binding IsChecked}"
                                VerticalAlignment="Top" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="2,0,0,0"
                                IsVisible="{Binding IsGhost}"
                                Text="⚠"
                                VerticalAlignment="Center"
                                ToolTip.Tip="This part is not present in the current drop table import" />
                            <TextBlock
                                Grid.Column="2"
                                Margin="4,0,0,0"
                                Text="{Binding PartName}"
                                TextWrapping="Wrap"
                                VerticalAlignment="Center"
                                Classes.ghost-part="{Binding IsGhost}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>

        </StackPanel>
      </ScrollViewer>
    </TabItem>


    <TabItem Header="Relics and Missions">
      <Grid ColumnDefinitions="*,*" Margin="0,12,0,0">

        <!-- Left column: Wishlist Relics -->
        <ScrollViewer Grid.Column="0" Margin="0,0,6,0">
          <StackPanel>

            <!-- Control panel -->
            <Border
                Margin="8,0,8,8"
                Padding="12,8"
                Background="#1A808080"
                CornerRadius="4">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <CheckBox IsChecked="{Binding WishlistRelics.ShowVaulted}" VerticalAlignment="Center" />
                  <TextBlock Text="Show vaulted relics" VerticalAlignment="Center" />
                </StackPanel>
                <Border Width="1" Background="Gray" Margin="4,0" VerticalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <CheckBox IsChecked="{Binding WishlistRelics.ShowAllRewards}" VerticalAlignment="Center" />
                  <TextBlock Text="Show all rewards" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- Empty state -->
            <TextBlock
                Margin="8,16"
                IsVisible="{Binding WishlistRelics.IsEmpty}"
                Text="Add items to your wishlist to see relics here." />

            <!-- Relic cards -->
            <ItemsControl ItemsSource="{Binding WishlistRelics.Cards}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:WishlistRelicCardViewModel}">
                  <Border
                      Margin="8"
                      Padding="12"
                      BorderBrush="Gray"
                      BorderThickness="1"
                      CornerRadius="4"
                      Width="200"
                      Classes.vaulted="{Binding IsVaulted}">
                    <StackPanel>
                      <TextBlock
                          Margin="0,0,0,6"
                          FontWeight="SemiBold"
                          Text="{Binding RelicName}"
                          TextWrapping="Wrap" />
                      <Separator Margin="0,0,0,6" />
                      <ItemsControl ItemsSource="{Binding TierGroups}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type local:WishlistRelicTierGroupViewModel}">
                            <StackPanel>
                              <TextBlock
                                  Margin="0,0,0,2"
                                  FontStyle="Italic"
                                  Text="{Binding TierName}" />
                              <ItemsControl ItemsSource="{Binding Rewards}">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="{x:Type local:WishlistRelicRewardViewModel}">
                                    <TextBlock
                                        Text="{Binding RewardName}"
                                        TextWrapping="Wrap"
                                        Classes.wishlisted="{Binding IsWishlisted}" />
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                              <Separator Margin="0,6,0,6" />
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </ScrollViewer>

        <!-- Right column: Farming Missions -->
        <ScrollViewer Grid.Column="1" Margin="6,0,0,0">
          <StackPanel>

            <!-- Empty state -->
            <TextBlock
                Margin="8,16"
                IsVisible="{Binding WishlistFarming.IsEmpty}"
                Text="Add items to your wishlist to see farming missions here." />

            <!-- Mission cards -->
            <ItemsControl ItemsSource="{Binding WishlistFarming.Cards}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:WishlistFarmingMissionCardViewModel}">
                  <Border
                      Margin="8"
                      Padding="12"
                      BorderBrush="Gray"
                      BorderThickness="1"
                      CornerRadius="4">
                    <StackPanel>

                      <!-- Card header: mission label + effective chance -->
                      <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <TextBlock
                            Grid.Column="0"
                            FontWeight="SemiBold"
                            Text="{Binding DisplayLabel}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            FontWeight="SemiBold"
                            Text="{Binding FormattedEffectiveChance}"
                            VerticalAlignment="Top" />
                      </Grid>
                      <Separator Margin="0,0,0,6" />

                      <!-- Non-rotation: flat relic list -->
                      <ItemsControl
                          ItemsSource="{Binding Relics}"
                          IsVisible="{Binding !HasRotations}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type local:WishlistFarmingMissionRelicViewModel}">
                            <Grid ColumnDefinitions="*,Auto">
                              <TextBlock
                                  Grid.Column="0"
                                  Text="{Binding RelicName}"
                                  TextWrapping="Wrap" />
                              <TextBlock
                                  Grid.Column="1"
                                  Margin="8,0,0,0"
                                  Text="{Binding FormattedChance}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <!-- Rotation missions: per-rotation sections -->
                      <ItemsControl
                          ItemsSource="{Binding Rotations}"
                          IsVisible="{Binding HasRotations}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type local:WishlistFarmingRotationViewModel}">
                            <StackPanel Margin="0,0,0,4">
                              <!-- Rotation header -->
                              <Grid ColumnDefinitions="*,Auto">
                                <TextBlock
                                    Grid.Column="0"
                                    FontStyle="Italic"
                                    Text="{Binding RotationLabel}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    FontStyle="Italic"
                                    Text="{Binding FormattedCumulativeChance}" />
                              </Grid>
                              <!-- Relics within this rotation -->
                              <ItemsControl ItemsSource="{Binding Relics}" Margin="12,2,0,0">
                                <ItemsControl.ItemTemplate>
                                  <DataTemplate DataType="{x:Type local:WishlistFarmingMissionRelicViewModel}">
                                    <Grid ColumnDefinitions="*,Auto">
                                      <TextBlock
                                          Grid.Column="0"
                                          Text="{Binding RelicName}"
                                          TextWrapping="Wrap" />
                                      <TextBlock
                                          Grid.Column="1"
                                          Margin="8,0,0,0"
                                          Text="{Binding FormattedChance}" />
                                    </Grid>
                                  </DataTemplate>
                                </ItemsControl.ItemTemplate>
                              </ItemsControl>
                            </StackPanel>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </ScrollViewer>

      </Grid>
    </TabItem>

  </TabControl>
</Window>
