<Window
    x:Class="WF.Reliquary.Presentation.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WF.Reliquary.Presentation"
    Title="WF Reliquary Redux"
    Width="900"
    Height="600">
  <Window.KeyBindings>
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="Border.vaulted">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
    <!-- Owned gear cards (visible only when "Show owned gear" is on) are muted. -->
    <Style Selector="Border.owned">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <!-- Vaulted prime gear cards are muted (class-driven so the fade can override it). -->
    <Style Selector="Border.gear-vaulted">
      <Setter Property="Opacity" Value="0.55" />
    </Style>
    <!-- Fade a card out before it is removed when marked owned with "Show owned gear"
         off. Declared last so its Opacity wins over the muted classes above. -->
    <Style Selector="Border.fading">
      <Setter Property="Opacity" Value="0" />
    </Style>
    <Style Selector="TextBlock.ghost-part">
      <Setter Property="Foreground" Value="#C0A000" />
      <Setter Property="FontStyle" Value="Italic" />
    </Style>
    <!-- Relic tier label: uniform accent color across all tiers (tier identity is
         carried by the accent bar, not the label). -->
    <Style Selector="TextBlock.tier-label">
      <Setter Property="Foreground" Value="{DynamicResource TierLabelBrush}" />
      <Setter Property="FontWeight" Value="DemiBold" />
    </Style>
    <!-- Non-wishlisted rewards dimmed when "Show all rewards" is on. -->
    <Style Selector="TextBlock.dimmed">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- Buttons inside Flyout popups: lighter background so they don't look
         like heavy stand-alone buttons in a dropdown list context. -->
    <Style Selector="FlyoutPresenter Button">
      <Setter Property="Background" Value="#18FFFFFF" />
    </Style>
    <!-- Per-tier accent bar color (left border of each tier group). -->
    <Style Selector="Border.tier-common">
      <Setter Property="BorderBrush" Value="{DynamicResource TierCommonBrush}" />
    </Style>
    <Style Selector="Border.tier-uncommon">
      <Setter Property="BorderBrush" Value="{DynamicResource TierUncommonBrush}" />
    </Style>
    <Style Selector="Border.tier-rare">
      <Setter Property="BorderBrush" Value="{DynamicResource TierRareBrush}" />
    </Style>
  </Window.Styles>

  <Panel>
  <DockPanel>

    <!-- Application menu bar -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem
            Header="_Drop Tables"
            Command="{Binding NavigateToDropTablesCommand}" />
        <MenuItem
            Header="_Settings"
            Command="{Binding NavigateToSettingsCommand}" />
      </MenuItem>
    </Menu>

    <!-- Footer: active profile + Drop Tables operation status -->
    <Border
        DockPanel.Dock="Bottom"
        Padding="12,6"
        Background="#1A808080">
      <StackPanel
          HorizontalAlignment="Left"
          VerticalAlignment="Center"
          Orientation="Horizontal">
        <TextBlock Text="Profile: " />
        <TextBlock
            MaxWidth="{StaticResource NameDisplayMaxWidth}"
            Text="{Binding Profiles.ActiveProfileName}"
            TextTrimming="CharacterEllipsis"
            ToolTip.Tip="{Binding Profiles.ActiveProfileName}" />
        <Border Width="1" Background="Gray" Margin="12,0" VerticalAlignment="Stretch" />
        <Path
            x:Name="FooterSpinner"
            Width="14" Height="14"
            Stretch="Uniform"
            StrokeThickness="1.5"
            StrokeLineCap="Round"
            Data="M 10 2 A 8 8 0 1 1 2 10"
            IsVisible="{Binding IsFooterBusy}"
            Margin="0,0,6,0"
            VerticalAlignment="Center"
            RenderTransformOrigin="50%,50%">
            <Path.Stroke>
                <SolidColorBrush Color="{DynamicResource SystemAccentColor}" />
            </Path.Stroke>
        </Path>
        <TextBlock
            IsVisible="{Binding IsFooterBusy}"
            Text="{Binding FooterOperationStatusText}"
            TextTrimming="CharacterEllipsis"
            VerticalAlignment="Center" />
        <TextBlock
            IsVisible="{Binding ShowFooterImportStatus}"
            Text="{Binding DropTables.FooterImportStatusText}"
            TextTrimming="CharacterEllipsis"
            VerticalAlignment="Center" />
        <TextBlock
            IsVisible="{Binding HasFooterError}"
            Text="{Binding FooterErrorText}"
            Foreground="OrangeRed"
            TextTrimming="CharacterEllipsis"
            VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Main tab control -->
    <TabControl x:Name="MainTabControl" Margin="16,12,16,24" SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

      <TabItem Header="Prime Gear">
        <ScrollViewer Margin="0,12,0,0">
          <StackPanel>

            <!-- Wishlist selector row -->
            <Border
                Margin="8,0,8,8"
                Padding="12,8"
                Background="#1A808080"
                CornerRadius="4">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Text="Wishlist:" VerticalAlignment="Center" />
                <Button
                    x:Name="WishlistDropdownButton"
                    MinWidth="160"
                    Padding="10,6"
                    Background="Transparent"
                    BorderBrush="Gray"
                    BorderThickness="1">
                  <TextBlock
                      MaxWidth="{StaticResource NameDisplayMaxWidth}"
                      Text="{Binding Wishlist.ActiveWishlistName}"
                      TextTrimming="CharacterEllipsis"
                      ToolTip.Tip="{Binding Wishlist.ActiveWishlistName}" />
                  <Button.Flyout>
                    <Flyout Placement="Bottom">
                      <StackPanel MinWidth="200" Spacing="0">

                        <!-- Existing wishlists -->
                        <ItemsControl ItemsSource="{Binding Wishlist.Wishlists}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:WishlistEntryViewModel}">
                              <Button
                                  HorizontalAlignment="Stretch"
                                  HorizontalContentAlignment="Left"
                                  Padding="12,6"
                                  Command="{Binding SelectCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                  <TextBlock Text="✓" IsVisible="{Binding IsActive}" Width="14" />
                                  <TextBlock Text=" " IsVisible="{Binding !IsActive}" Width="14" />
                                  <TextBlock Text="{Binding Name}" />
                                </StackPanel>
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Separator -->
                        <Separator Margin="0,4" />

                        <!-- Management actions -->
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,6"
                            Command="{Binding Wishlist.RenameCommand}"
                            Content="Rename this list…" />
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,6"
                            Command="{Binding Wishlist.DeleteCommand}"
                            IsEnabled="{Binding Wishlist.CanDelete}"
                            Content="Delete this list" />
                        <Button
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Padding="12,6"
                            Command="{Binding Wishlist.CreateCommand}"
                            Content="+ New list" />

                      </StackPanel>
                    </Flyout>
                  </Button.Flyout>
                </Button>
                <Border Width="1" Background="Gray" Margin="4,0" VerticalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <CheckBox IsChecked="{Binding PrimeGear.ShowVaulted}" VerticalAlignment="Center" />
                  <TextBlock Text="Show vaulted gear" VerticalAlignment="Center" />
                </StackPanel>
                <Border Width="1" Background="Gray" Margin="4,0" VerticalAlignment="Stretch" />
                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <CheckBox IsChecked="{Binding PrimeGear.ShowOwned}" VerticalAlignment="Center" />
                  <TextBlock Text="Show owned gear" VerticalAlignment="Center" />
                </StackPanel>
              </StackPanel>
            </Border>

            <!-- In-content busy indicator: shows which view is reloading. -->
            <TextBlock
                Margin="8,0,8,8"
                Text="Updating…"
                Opacity="0.7"
                FontStyle="Italic"
                IsVisible="{Binding PrimeGear.IsBusy}" />

            <!-- Active gear section -->
            <ItemsControl ItemsSource="{Binding PrimeGear.ActiveCards}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:PrimeGearCardViewModel}">
                  <Border
                      Margin="8"
                      Padding="12"
                      BorderBrush="Gray"
                      BorderThickness="1"
                      CornerRadius="4"
                      Width="180"
                      Classes.owned="{Binding IsOwned}"
                      Classes.fading="{Binding IsFadingOut}">
                    <Border.Transitions>
                      <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                      </Transitions>
                    </Border.Transitions>
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            Grid.Column="0"
                            FontWeight="SemiBold"
                            Text="{Binding GearName}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Content="⋮"
                            ToolTip.Tip="{Binding OwnedMenuLabel}"
                            ToolTip.ShowDelay="1000">
                          <Button.Flyout>
                            <!-- Right-align the menu to the button so it opens to the
                                 left, then nudge it 30px back toward the button. -->
                            <MenuFlyout Placement="BottomEdgeAlignedRight" HorizontalOffset="25">
                              <MenuItem
                                  Header="{Binding OwnedMenuLabel}"
                                  Command="{Binding MarkOwnedCommand}" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Parts}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type local:PrimePartViewModel}">
                            <Grid ColumnDefinitions="Auto,Auto,*">
                              <CheckBox
                                  Grid.Column="0"
                                  IsChecked="{Binding IsChecked}"
                                  VerticalAlignment="Top" />
                              <TextBlock
                                  Grid.Column="1"
                                  Margin="2,0,0,0"
                                  IsVisible="{Binding IsGhost}"
                                  Text="⚠"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="This part is not present in the current drop table import" />
                              <TextBlock
                                  Grid.Column="2"
                                  Margin="4,0,0,0"
                                  Text="{Binding PartName}"
                                  TextWrapping="Wrap"
                                  VerticalAlignment="Center"
                                  Classes.ghost-part="{Binding IsGhost}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Vaulted section header -->
            <Border
                Margin="8,8,8,0"
                Padding="12,8"
                Background="#1A808080"
                CornerRadius="4"
                IsVisible="{Binding PrimeGear.ShowVaulted}">
              <TextBlock FontWeight="SemiBold" Text="Vaulted" />
            </Border>

            <!-- Vaulted gear section -->
            <ItemsControl
                ItemsSource="{Binding PrimeGear.VaultedCards}"
                IsVisible="{Binding PrimeGear.ShowVaulted}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:PrimeGearCardViewModel}">
                  <Border
                      Margin="8"
                      Padding="12"
                      BorderBrush="Gray"
                      BorderThickness="1"
                      CornerRadius="4"
                      Width="180"
                      Classes.gear-vaulted="True"
                      Classes.fading="{Binding IsFadingOut}">
                    <Border.Transitions>
                      <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
                      </Transitions>
                    </Border.Transitions>
                    <StackPanel Spacing="6">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock
                            Grid.Column="0"
                            FontWeight="SemiBold"
                            Text="{Binding GearName}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center" />
                        <Button
                            Grid.Column="1"
                            Margin="4,0,0,0"
                            Padding="6,2"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Content="⋮"
                            ToolTip.Tip="{Binding OwnedMenuLabel}"
                            ToolTip.ShowDelay="1000">
                          <Button.Flyout>
                            <!-- Right-align the menu to the button so it opens to the
                                 left, then nudge it 30px back toward the button. -->
                            <MenuFlyout Placement="BottomEdgeAlignedRight" HorizontalOffset="25">
                              <MenuItem
                                  Header="{Binding OwnedMenuLabel}"
                                  Command="{Binding MarkOwnedCommand}" />
                            </MenuFlyout>
                          </Button.Flyout>
                        </Button>
                      </Grid>
                      <ItemsControl ItemsSource="{Binding Parts}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate DataType="{x:Type local:PrimePartViewModel}">
                            <Grid ColumnDefinitions="Auto,Auto,*">
                              <CheckBox
                                  Grid.Column="0"
                                  IsChecked="{Binding IsChecked}"
                                  VerticalAlignment="Top" />
                              <TextBlock
                                  Grid.Column="1"
                                  Margin="2,0,0,0"
                                  IsVisible="{Binding IsGhost}"
                                  Text="⚠"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="This part is not present in the current drop table import" />
                              <TextBlock
                                  Grid.Column="2"
                                  Margin="4,0,0,0"
                                  Text="{Binding PartName}"
                                  TextWrapping="Wrap"
                                  VerticalAlignment="Center"
                                  Classes.ghost-part="{Binding IsGhost}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </StackPanel>
        </ScrollViewer>
      </TabItem>


      <TabItem Header="Relics and Missions">
        <Grid x:Name="RelicsMissionsGrid" Margin="0,12,0,0" RowDefinitions="Auto,*,5,*">

          <!-- Row 0: Control panel -->
          <Border
              Grid.Row="0"
              Margin="8,0,8,8"
              Padding="12,8"
              Background="#1A808080"
              CornerRadius="4">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="Relics:" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <CheckBox IsChecked="{Binding WishlistRelics.ShowVaulted}" VerticalAlignment="Center" />
                <TextBlock Text="Show vaulted" VerticalAlignment="Center" />
              </StackPanel>
              <Border Width="1" Background="Gray" Margin="4,0" VerticalAlignment="Stretch" />
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <CheckBox IsChecked="{Binding WishlistRelics.ShowAllRewards}" VerticalAlignment="Center" />
                <TextBlock Text="Show all rewards" VerticalAlignment="Center" />
              </StackPanel>
              <Border Width="2" Background="Gray" Margin="10,0" VerticalAlignment="Stretch" />
              <TextBlock Text="Missions:" VerticalAlignment="Center" />
              <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                <CheckBox IsChecked="{Binding WishlistFarming.ShowExactDropChances}" VerticalAlignment="Center" />
                <TextBlock Text="Show exact drop chances" VerticalAlignment="Center" />
              </StackPanel>
              <!-- In-content busy indicator for the Relics/Missions reload. -->
              <TextBlock
                  Text="Updating…"
                  Opacity="0.7"
                  FontStyle="Italic"
                  VerticalAlignment="Center"
                  IsVisible="{Binding WishlistRelics.IsBusy}" />
            </StackPanel>
          </Border>

          <!-- Row 1: Relics scroll -->
          <ScrollViewer x:Name="RelicsScrollViewer" Grid.Row="1">
            <StackPanel>

              <!-- Relics empty state -->
              <TextBlock
                  Margin="8,16"
                  IsVisible="{Binding WishlistRelics.IsEmpty}"
                  Text="Add items to your wishlist to see relics here." />

              <!-- Relic cards -->
              <ItemsControl ItemsSource="{Binding WishlistRelics.Cards}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:WishlistRelicCardViewModel}">
                    <Border
                        Margin="8"
                        Padding="12"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4"
                        Width="{DynamicResource RelicCardWidth}"
                        Classes.vaulted="{Binding IsVaulted}">
                      <StackPanel>
                        <TextBlock
                            Margin="0,0,0,6"
                            FontWeight="SemiBold"
                            Text="{Binding RelicName}"
                            TextWrapping="Wrap" />
                        <Separator Margin="0,0,0,6" />
                        <ItemsControl ItemsSource="{Binding TierGroups}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:WishlistRelicTierGroupViewModel}">
                              <!-- Per-tier accent bar in the left gutter; color encodes the
                                   tier and the bar spans the whole group (label + wrapped
                                   reward lines), replacing per-group separators. -->
                              <Border
                                  Margin="0,0,0,8"
                                  Padding="6,0,0,0"
                                  BorderThickness="3,0,0,0"
                                  Classes.tier-common="{Binding IsCommon}"
                                  Classes.tier-uncommon="{Binding IsUncommon}"
                                  Classes.tier-rare="{Binding IsRare}">
                                <StackPanel>
                                  <TextBlock
                                      Margin="0,0,0,2"
                                      Classes="tier-label"
                                      Text="{Binding TierName}" />
                                  <!-- Reward names indented beneath the tier label so the
                                       label stands out and the rewards read as its list. -->
                                  <ItemsControl ItemsSource="{Binding Rewards}" Margin="12,0,0,0">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate DataType="{x:Type local:WishlistRelicRewardViewModel}">
                                        <TextBlock
                                            Text="{Binding RewardName}"
                                            TextWrapping="Wrap"
                                            Classes.dimmed="{Binding IsDimmed}" />
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </ScrollViewer>

          <!-- Row 2: GridSplitter -->
          <GridSplitter
              x:Name="RelicsSplitter"
              Grid.Row="2"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch"
              ResizeDirection="Rows"
              Background="#28808080">
            <GridSplitter.Styles>
              <Style Selector="GridSplitter:pointerover">
                <Setter Property="Background" Value="#50808080" />
              </Style>
              <Style Selector="GridSplitter:pressed">
                <Setter Property="Background" Value="#70808080" />
              </Style>
            </GridSplitter.Styles>
          </GridSplitter>

          <!-- Row 3: Missions scroll -->
          <ScrollViewer Grid.Row="3" Margin="0,8,0,0">
            <StackPanel>

              <!-- Missions empty state -->
              <TextBlock
                  Margin="8,16"
                  IsVisible="{Binding WishlistFarming.IsEmpty}"
                  Text="Add items to your wishlist to see farming missions here." />

              <!-- Mission cards -->
              <ItemsControl ItemsSource="{Binding WishlistFarming.Cards}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="{x:Type local:WishlistFarmingMissionGroupCardViewModel}">
                    <Border
                        Margin="8"
                        Padding="12"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        CornerRadius="4"
                        Width="{DynamicResource MissionCardWidth}">
                      <StackPanel>

                        <!-- Card header: mission type title + effective chance -->
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                          <TextBlock
                              Grid.Column="0"
                              FontWeight="SemiBold"
                              Text="{Binding GroupTitle}"
                              TextWrapping="Wrap" />
                          <TextBlock
                              Grid.Column="1"
                              Margin="8,0,0,0"
                              FontWeight="SemiBold"
                              Text="{Binding FormattedEffectiveChance}"
                              VerticalAlignment="Top" />
                        </Grid>
                        <Separator Margin="0,0,0,6" />

                        <!-- Nodes: member mission labels -->
                        <TextBlock
                            Margin="0,0,0,6"
                            FontStyle="Italic"
                            Opacity="0.7"
                            Text="{Binding NodesLabel}"
                            TextWrapping="Wrap" />

                        <!-- Non-rotation: flat relic list (detailed) or compact row -->
                        <StackPanel IsVisible="{Binding !HasRotations}">
                          <ItemsControl
                              ItemsSource="{Binding Relics}"
                              IsVisible="{Binding ShowExactDropChances}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate DataType="{x:Type local:WishlistFarmingMissionRelicViewModel}">
                                <Grid ColumnDefinitions="*,Auto">
                                  <TextBlock
                                      Grid.Column="0"
                                      Text="{Binding RelicName}"
                                      TextWrapping="Wrap" />
                                  <TextBlock
                                      Grid.Column="1"
                                      Margin="8,0,0,0"
                                      Text="{Binding FormattedChance}" />
                                </Grid>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                          <TextBlock
                              Text="{Binding CompactRelicNames}"
                              TextWrapping="Wrap"
                              IsVisible="{Binding !ShowExactDropChances}" />
                        </StackPanel>

                        <!-- Rotation missions: per-rotation sections -->
                        <ItemsControl
                            ItemsSource="{Binding Rotations}"
                            IsVisible="{Binding HasRotations}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:WishlistFarmingRotationViewModel}">
                              <StackPanel Margin="0,0,0,4">
                                <!-- Rotation header: label + cumulative chance (always visible) -->
                                <Grid ColumnDefinitions="*,Auto">
                                  <TextBlock
                                      Grid.Column="0"
                                      FontStyle="Italic"
                                      Text="{Binding RotationLabel}" />
                                  <TextBlock
                                      Grid.Column="1"
                                      Margin="8,0,0,0"
                                      FontStyle="Italic"
                                      Text="{Binding FormattedCumulativeChance}" />
                                </Grid>
                                <!-- Relics within this rotation: detailed rows -->
                                <ItemsControl
                                    ItemsSource="{Binding Relics}"
                                    Margin="12,2,0,0"
                                    IsVisible="{Binding ShowExactDropChances}">
                                  <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:WishlistFarmingMissionRelicViewModel}">
                                      <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock
                                            Grid.Column="0"
                                            Text="{Binding RelicName}"
                                            TextWrapping="Wrap" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="8,0,0,0"
                                            Text="{Binding FormattedChance}" />
                                      </Grid>
                                    </DataTemplate>
                                  </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Relics within this rotation: compact row -->
                                <TextBlock
                                    Margin="12,2,0,0"
                                    Text="{Binding CompactRelicNames}"
                                    TextWrapping="Wrap"
                                    IsVisible="{Binding !ShowExactDropChances}" />
                              </StackPanel>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>

                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </ScrollViewer>

        </Grid>
      </TabItem>

      <!-- Drop Tables tab — File-menu accessed; header shows while active, or when no data is imported -->
      <TabItem>
        <TabItem.Header>
          <TextBlock
              Text="Drop Tables"
              FontSize="{Binding $parent[TabItem].FontSize}"
              FontFamily="{Binding $parent[TabItem].FontFamily}"
              FontWeight="{Binding $parent[TabItem].FontWeight}"
              IsVisible="{Binding ShowDropTablesTabHeader}" />
        </TabItem.Header>
        <StackPanel Margin="0,12,0,0" Spacing="16">

          <!-- Section: Source acquisition -->
          <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="Source acquisition" />
            <TextBlock
                Text="{Binding DropTables.SourceStatusText}"
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button
                  Padding="14,8"
                  Command="{Binding DropTables.DownloadCommand}"
                  Content="Download from URL" />
              <Button
                  Padding="14,8"
                  Command="{Binding DropTables.ReadFromFileCommand}"
                  Content="Read from file" />
            </StackPanel>
          </StackPanel>

          <Separator />

          <!-- Section: Import -->
          <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="Import" />
            <TextBlock
                Text="{Binding DropTables.ImportStatusText}"
                TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button
                  Padding="14,8"
                  Command="{Binding DropTables.ImportCommand}"
                  Content="Import stored source" />
              <Button
                  Padding="14,8"
                  Command="{Binding DropTables.ClearImportCommand}"
                  Content="Clear imported data" />
            </StackPanel>
          </StackPanel>

          <Separator />

          <!-- Section: Export -->
          <StackPanel Spacing="8">
            <TextBlock FontWeight="SemiBold" Text="Export" />
            <Button
                Padding="14,8"
                HorizontalAlignment="Left"
                IsEnabled="{Binding DropTables.HasStoredSources}"
                Command="{Binding DropTables.ExportSourcesCommand}"
                Content="Export stored sources" />
          </StackPanel>


        </StackPanel>
      </TabItem>

      <!-- Settings tab — File-menu accessed; header shows only while this tab is active -->
      <TabItem>
        <TabItem.Header>
          <TextBlock
              Text="Settings"
              FontSize="{Binding $parent[TabItem].FontSize}"
              FontFamily="{Binding $parent[TabItem].FontFamily}"
              FontWeight="{Binding $parent[TabItem].FontWeight}"
              IsVisible="{Binding $parent[TabItem].IsSelected}" />
        </TabItem.Header>
        <local:SettingsView Margin="0,0,0,0" />
      </TabItem>

    </TabControl>
  </DockPanel>

  <!-- Toast overlay: stacks error cards at the bottom-right above the footer. -->
  <StackPanel
      x:Name="ToastPanel"
      VerticalAlignment="Bottom"
      HorizontalAlignment="Right"
      Margin="0,0,16,52"
      Spacing="0"
      MaxWidth="360" />

  </Panel>
</Window>
