<?xml version="1.0" encoding="utf-8"?>
<!--
  Framework-dependent win-x64 publish profile.

  Produces a single .exe that requires the .NET 10 Desktop Runtime (x64) to be
  installed on the target machine. Single-file so the "small" build actually
  looks small to end users (one exe, not a folder of ~60 DLLs); native libraries
  ride inside and self-extract on first launch. No self-contained runtime.
  (Single-file compression is a self-contained-only feature, so it's not used
  here — the release zip handles download size anyway.) No trimming: Avalonia +
  EF Core rely on reflection.

  Local use: dotnet publish -p:PublishProfile=win-x64-framework-dependent
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishDir>bin\publish\win-x64-framework-dependent\</PublishDir>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
  </PropertyGroup>

  <!-- Keep the artifact lean: drop NuGet-provided native debug symbols
       (libSkiaSharp.pdb, libHarfBuzzSharp.pdb — ~100 MB combined) that ship
       via SkiaSharp/HarfBuzzSharp runtime targets. Managed WF.*.pdb are kept. -->
  <Target Name="RemoveNativeSymbolFiles" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
        Condition="'%(Extension)' == '.pdb' And $([System.String]::new('%(Filename)').StartsWith('lib'))" />
    </ItemGroup>
  </Target>
</Project>
