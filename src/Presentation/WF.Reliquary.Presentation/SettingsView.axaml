<UserControl
    x:Class="WF.Reliquary.Presentation.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WF.Reliquary.Presentation">

  <StackPanel Margin="0,12,0,0" Spacing="20" MaxWidth="600" HorizontalAlignment="Left">

    <!-- Profiles -->
    <StackPanel Spacing="8">
      <TextBlock FontWeight="SemiBold" Text="Profiles" />
      <TextBlock
          Foreground="Gray"
          TextWrapping="Wrap"
          Text="Track multiple accounts separately. Each profile has its own wishlists." />
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="Profile:" VerticalAlignment="Center" />
        <Button
            x:Name="ProfileDropdownButton"
            MinWidth="160"
            Padding="10,6"
            Background="Transparent"
            BorderBrush="Gray"
            BorderThickness="1">
          <TextBlock
              MaxWidth="{StaticResource NameDisplayMaxWidth}"
              Text="{Binding Profiles.ActiveProfileName}"
              TextTrimming="CharacterEllipsis"
              ToolTip.Tip="{Binding Profiles.ActiveProfileName}" />
          <Button.Flyout>
            <Flyout Placement="Bottom">
              <StackPanel MinWidth="200" Spacing="0">

                <!-- Existing profiles -->
                <ItemsControl ItemsSource="{Binding Profiles.Profiles}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ProfileEntryViewModel}">
                      <Button
                          HorizontalAlignment="Stretch"
                          HorizontalContentAlignment="Left"
                          Padding="12,6"
                          Command="{Binding SelectCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="✓" IsVisible="{Binding IsActive}" Width="14" />
                          <TextBlock Text=" " IsVisible="{Binding !IsActive}" Width="14" />
                          <TextBlock Text="{Binding Name}" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Separator -->
                <Separator Margin="0,4" />

                <!-- Management actions -->
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Padding="12,6"
                    Command="{Binding Profiles.RenameCommand}"
                    Content="Rename this profile…" />
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Padding="12,6"
                    Command="{Binding Profiles.DeleteCommand}"
                    IsEnabled="{Binding Profiles.CanDelete}"
                    Content="Delete this profile" />
                <Button
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Padding="12,6"
                    Command="{Binding Profiles.CreateCommand}"
                    Content="+ New profile" />

              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
      </StackPanel>
    </StackPanel>

    <Separator />

    <!-- Font size -->
    <StackPanel Spacing="8">
      <TextBlock FontWeight="SemiBold" Text="Font size" />
      <StackPanel Orientation="Horizontal" Spacing="16">
        <RadioButton
            Content="Small"
            IsChecked="{Binding Settings.SelectedFontSize, Converter={x:Static local:EnumToBoolConverter.Instance}, ConverterParameter=Small}"
            GroupName="FontSize" />
        <RadioButton
            Content="Medium"
            IsChecked="{Binding Settings.SelectedFontSize, Converter={x:Static local:EnumToBoolConverter.Instance}, ConverterParameter=Medium}"
            GroupName="FontSize" />
        <RadioButton
            Content="Large"
            IsChecked="{Binding Settings.SelectedFontSize, Converter={x:Static local:EnumToBoolConverter.Instance}, ConverterParameter=Large}"
            GroupName="FontSize" />
      </StackPanel>
    </StackPanel>

    <Separator />

    <!-- Drop-tables source URL -->
    <StackPanel Spacing="8">
      <TextBlock FontWeight="SemiBold" Text="Drop-table source URL" />
      <TextBox
          MinWidth="480"
          Text="{Binding Settings.SourceUrlText, Mode=TwoWay}" />
      <TextBlock
          Foreground="OrangeRed"
          IsVisible="{Binding Settings.UrlValidationError, Converter={x:Static local:NonEmptyStringToBoolConverter.Instance}}"
          Text="{Binding Settings.UrlValidationError}" />
    </StackPanel>

    <Separator />

    <!-- LFG message constructor -->
    <StackPanel Spacing="8">
      <TextBlock FontWeight="SemiBold" Text="LFG message constructor" />
      <TextBlock
          Foreground="Gray"
          TextWrapping="Wrap"
          Text="Customize the pattern used to generate recruiting-chat messages from relic cards. Use {relic_name} as a system placeholder (resolved from the card). Other {placeholders} become option groups." />

      <!-- Pattern row -->
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox
            MinWidth="300"
            Text="{Binding LfgEditor.PatternText, Mode=TwoWay}" />
        <Button
            Padding="14,6"
            Command="{Binding LfgEditor.ParseCommand}"
            Content="Parse" />
      </StackPanel>

      <!-- Validation / warning -->
      <TextBlock
          Foreground="OrangeRed"
          IsVisible="{Binding LfgEditor.ParseError, Converter={x:Static local:NonEmptyStringToBoolConverter.Instance}}"
          Text="{Binding LfgEditor.ParseError}"
          TextWrapping="Wrap" />
      <TextBlock
          Foreground="#87C232"
          IsVisible="{Binding LfgEditor.ParseWarning, Converter={x:Static local:NonEmptyStringToBoolConverter.Instance}}"
          Text="{Binding LfgEditor.ParseWarning}"
          TextWrapping="Wrap" />

      <!-- Per-group editors -->
      <ItemsControl ItemsSource="{Binding LfgEditor.Groups}">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:LfgGroupEditorViewModel}">
            <Border
                Margin="0,8,0,0"
                Padding="10"
                BorderBrush="Gray"
                BorderThickness="1"
                CornerRadius="4">
              <StackPanel Spacing="6">
                <TextBlock FontWeight="SemiBold" Text="{Binding Placeholder}" />

                <!-- Option rows -->
                <ItemsControl ItemsSource="{Binding Options}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:LfgOptionEditorViewModel}">
                      <Grid ColumnDefinitions="*,Auto,*,8,Auto" Margin="0,2">
                        <TextBox
                            Grid.Column="0"
                            Text="{Binding Descriptor, Mode=TwoWay}"
                            PlaceholderText="Label" />
                        <TextBlock Grid.Column="1" Text="->" VerticalAlignment="Center" Margin="10,0" />
                        <TextBox
                            Grid.Column="2"
                            Text="{Binding Value, Mode=TwoWay}"
                            PlaceholderText="Value" />
                        <Button
                            Grid.Column="4"
                            Padding="8,4"
                            Command="{Binding $parent[ItemsControl].((local:LfgGroupEditorViewModel)DataContext).RemoveOptionCommand}"
                            CommandParameter="{Binding}"
                            Content="✕" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button
                      Padding="10,4"
                      Command="{Binding AddOptionCommand}"
                      Content="+ Option" />
                  <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Text="Default:" VerticalAlignment="Center" />
                    <ComboBox
                        MinWidth="120"
                        ItemsSource="{Binding Options}"
                        SelectedItem="{Binding SelectedDefaultOption, Mode=TwoWay}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:LfgOptionEditorViewModel}">
                          <TextBlock Text="{Binding Descriptor}" />
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                  </StackPanel>
                </StackPanel>

              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Editor actions -->
      <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
        <Button
            Padding="14,6"
            Command="{Binding LfgEditor.RestoreDefaultsCommand}"
            Content="Restore defaults" />
      </StackPanel>
    </StackPanel>

    <Separator />

    <!-- Maintenance -->
    <StackPanel Spacing="8">
      <TextBlock FontWeight="SemiBold" Text="Maintenance" />
      <TextBlock
          Foreground="Gray"
          TextWrapping="Wrap"
          Text="Errors are written to an application log file." />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button
            Padding="14,8"
            Command="{Binding Settings.OpenLogFileCommand}"
            Content="Open log file" />
        <Button
            Padding="14,8"
            Command="{Binding Settings.CopyLogPathCommand}"
            Content="Copy log path" />
      </StackPanel>
    </StackPanel>

    <Separator />

    <!-- Save / Back -->
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Button
          Padding="14,8"
          Command="{Binding Settings.SaveCommand}"
          Content="Save" />
      <Button
          Padding="14,8"
          Command="{Binding Settings.BackCommand}"
          Content="Back" />
    </StackPanel>

  </StackPanel>
</UserControl>
