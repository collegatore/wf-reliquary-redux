<Window
    x:Class="WF.Reliquary.Presentation.ConfirmSourceOverwriteDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Replace existing source?"
    Width="400"
    Height="170"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="20">
    <StackPanel VerticalAlignment="Center" Spacing="6">
      <TextBlock
          TextWrapping="Wrap"
          Text="A source with this version already exists:" />
      <TextBlock
          x:Name="VersionText"
          FontWeight="SemiBold"
          TextWrapping="Wrap" />
      <TextBlock
          x:Name="DownloadedAtText"
          TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel
        Grid.Row="1"
        Margin="0,12,0,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal"
        Spacing="8">
      <Button
          x:Name="ReplaceButton"
          Padding="14,6"
          Content="Replace" />
      <Button
          x:Name="CancelButton"
          Padding="14,6"
          Content="Cancel" />
    </StackPanel>
  </Grid>
</Window>
