<UserControl
    x:Class="WF.Reliquary.Presentation.PrimeGearView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WF.Reliquary.Presentation">

  <UserControl.Resources>
    <!-- Shared gear-card template used by both the Active and Vaulted sections, so the
         card chrome (owned outline, ✓ marker, ⋮ / selection-checkbox swap) lives in one
         place and cannot drift between sections. -->
    <DataTemplate x:Key="GearCardTemplate" DataType="{x:Type local:PrimeGearCardViewModel}">
      <!-- Panel layers a transparent full-card click target over the card. In group
           mode the overlay is shown: clicking anywhere selects the card and the inner
           controls (parts, overflow menu) are suppressed. To make that discoverable,
           group mode also swaps the ⋮ button for a selection checkbox, dims the parts
           list, and outlines the card on hover (overlay style in MainWindow.axaml). -->
      <Panel IsVisible="{Binding IsShown}">
        <Border
            Margin="8"
            Padding="12"
            CornerRadius="4"
            Width="180"
            Classes="gear-card"
            Classes.owned="{Binding IsOwned}"
            Classes.selected="{Binding IsSelected}"
            Classes.fading="{Binding IsFadingOut}">
          <Border.Transitions>
            <Transitions>
              <DoubleTransition Property="Opacity" Duration="0:0:0.18" />
            </Transitions>
          </Border.Transitions>
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <!-- Name with the owned ✓ marker immediately after it. -->
              <StackPanel
                  Grid.Column="0"
                  Orientation="Horizontal"
                  Spacing="4"
                  VerticalAlignment="Center">
                <TextBlock
                    MaxWidth="110"
                    FontWeight="SemiBold"
                    Text="{Binding GearName}"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center" />
                <TextBlock
                    Text="✓"
                    FontWeight="Bold"
                    Foreground="{DynamicResource OwnedAccentBrush}"
                    IsVisible="{Binding IsOwned}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Owned" />
              </StackPanel>
              <!-- Fixed-width slot: the ⋮ menu outside group mode, the selection
                   checkbox inside it, so the header doesn't shift on the swap. -->
              <Panel Grid.Column="1" Margin="4,0,0,0" Width="20" Height="24" VerticalAlignment="Center">
                <Button
                    Padding="6,2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    FontWeight="Bold"
                    Content="⋮"
                    ToolTip.Tip="{Binding OwnedMenuLabel}"
                    ToolTip.ShowDelay="1000"
                    IsVisible="{Binding !DataContext.PrimeGear.IsGroupMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                  <Button.Flyout>
                    <!-- Right-align the menu to the button so it opens to the
                         left, then nudge it 30px back toward the button. -->
                    <MenuFlyout Placement="BottomEdgeAlignedRight" HorizontalOffset="25" FlyoutPresenterClasses="app-menu">
                      <MenuItem
                          Header="{Binding OwnedMenuLabel}"
                          Command="{Binding MarkOwnedCommand}" />
                    </MenuFlyout>
                  </Button.Flyout>
                </Button>
                <!-- Display-only: the selection overlay above the card takes every
                     click (including on this box) and toggles the selection. -->
                <CheckBox
                    Padding="0"
                    MinHeight="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsSelected, Mode=OneWay}"
                    IsHitTestVisible="False"
                    IsVisible="{Binding DataContext.PrimeGear.IsGroupMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
                  <CheckBox.Resources>
                    <!-- Fluent sizes the box row from this resource (32) inside the
                         template; shrink it so the header keeps its height. -->
                    <x:Double x:Key="CheckBoxMinHeight">20</x:Double>
                  </CheckBox.Resources>
                </CheckBox>
              </Panel>
            </Grid>
            <ItemsControl
                ItemsSource="{Binding Parts}"
                Classes="gear-parts"
                Classes.group-mode="{Binding DataContext.PrimeGear.IsGroupMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type local:PrimePartViewModel}">
                  <Grid ColumnDefinitions="Auto,Auto,*">
                    <CheckBox
                        Grid.Column="0"
                        IsChecked="{Binding IsChecked}"
                        VerticalAlignment="Top" />
                    <TextBlock
                        Grid.Column="1"
                        Margin="2,0,0,0"
                        IsVisible="{Binding IsGhost}"
                        Text="⚠"
                        VerticalAlignment="Center"
                        ToolTip.Tip="This part is not present in the current drop table import" />
                    <TextBlock
                        Grid.Column="2"
                        Margin="4,0,0,0"
                        Text="{Binding PartName}"
                        TextWrapping="Wrap"
                        VerticalAlignment="Center"
                        Classes.ghost-part="{Binding IsGhost}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <!-- Selection overlay: only hit-testable in group mode (transparent fill is
             still clickable; collapsed otherwise so the card behaves normally). -->
        <Button
            Classes="card-select-overlay"
            Margin="8"
            Padding="0"
            BorderThickness="0"
            Cursor="Hand"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            VerticalContentAlignment="Stretch"
            Command="{Binding ToggleSelectCommand}"
            ToolTip.Tip="Click to select for group operations"
            IsVisible="{Binding DataContext.PrimeGear.IsGroupMode, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" />
      </Panel>
    </DataTemplate>
  </UserControl.Resources>

  <!-- The control panel (filter row + group-ops row) is docked to the top so it stays
       put while only the card sections scroll. -->
  <DockPanel Margin="0,12,0,0">
    <StackPanel DockPanel.Dock="Top">

      <!-- Wishlist selector / filter row. Look comes from Styles/ControlBars.axaml. -->
      <Border Classes="control-bar">
        <DockPanel>

          <!-- Right side: search box and hidden-match hint -->
          <StackPanel
              DockPanel.Dock="Right"
              Orientation="Vertical"
              Spacing="2"
              VerticalAlignment="Center">
            <TextBox
                Text="{Binding PrimeGear.SearchText, Mode=TwoWay}"
                PlaceholderText="Search gear…"
                Width="200" />
            <TextBlock
                Text="{Binding PrimeGear.HiddenMatchHint}"
                IsVisible="{Binding PrimeGear.HasHiddenMatches}"
                Opacity="0.65"
                FontSize="11"
                FontStyle="Italic" />
          </StackPanel>

          <!-- Left side: wishlist selector and toggles. The "Wishlist" caption sits
               inside the selector's closed field (SelectionBoxItemTemplate), so it
               can't read as a row title; the open list shows names only. -->
          <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <!-- Selector + its ⋮ actions menu, kept tighter than the bar's spacing. -->
            <StackPanel Orientation="Horizontal" Spacing="4">
            <ComboBox
                MinWidth="160"
                ItemsSource="{Binding Wishlist.Wishlists}"
                SelectedItem="{Binding Wishlist.SelectedEntry, Mode=TwoWay}">
              <ComboBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:WishlistEntryViewModel}">
                  <TextBlock
                      MaxWidth="{StaticResource NameDisplayMaxWidth}"
                      Text="{Binding Name}"
                      TextTrimming="CharacterEllipsis"
                      ToolTip.Tip="{Binding Name}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
              <ComboBox.SelectionBoxItemTemplate>
                <DataTemplate DataType="{x:Type local:WishlistEntryViewModel}">
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Classes="field-caption" Text="Wishlist:" />
                    <TextBlock
                        MaxWidth="{StaticResource NameDisplayMaxWidth}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        VerticalAlignment="Center"
                        ToolTip.Tip="{Binding Name}" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.SelectionBoxItemTemplate>
            </ComboBox>
            <Button Classes="dropdown-field icon-only" ToolTip.Tip="Wishlist actions">
              <PathIcon Data="{StaticResource Icon.MoreVertical}" />
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft" FlyoutPresenterClasses="app-menu">
                  <MenuItem Header="Rename this list…" Command="{Binding Wishlist.RenameCommand}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Pencil}" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Classes="destructive" Header="Delete this list" Command="{Binding Wishlist.DeleteCommand}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Trash}" /></MenuItem.Icon>
                  </MenuItem>
                  <MenuItem Header="New list" Command="{Binding Wishlist.CreateCommand}">
                    <MenuItem.Icon><PathIcon Data="{StaticResource Icon.Plus}" /></MenuItem.Icon>
                  </MenuItem>
                </MenuFlyout>
              </Button.Flyout>
            </Button>
            </StackPanel>
            <StackPanel Classes="button-group">
              <Button
                  Command="{Binding PrimeGear.ToggleFilterPanelCommand}"
                  Content="Filters"
                  ToolTip.Tip="Show or hide filter options" />
              <Button
                  Command="{Binding PrimeGear.ToggleGroupModeCommand}"
                  Content="Group operations"
                  ToolTip.Tip="Enable or disable group selection and bulk actions" />
            </StackPanel>
          </StackPanel>

        </DockPanel>
      </Border>

      <!-- Filter panel: shown when the Filters button is toggled on. -->
      <Border
          Classes="control-bar"
          IsVisible="{Binding PrimeGear.IsFilterPanelOpen}">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <CheckBox Classes="chip" Content="Show vaulted gear" IsChecked="{Binding PrimeGear.ShowVaulted}" />
          <CheckBox Classes="chip" Content="Show owned gear" IsChecked="{Binding PrimeGear.ShowOwned}" />
          <CheckBox Classes="chip" Content="Wishlisted only" IsChecked="{Binding PrimeGear.ShowWishlistedOnly}" />
        </StackPanel>
      </Border>

      <!-- Group-operations control row: only shown while group operations is enabled. -->
      <Border
          Classes="control-bar"
          IsVisible="{Binding PrimeGear.IsGroupMode}">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <!-- Selection status: hint while nothing is selected, then the count. The
               invisible copy of the hint keeps the cell as wide as the hint at any
               font size, so the action buttons don't shift as the text changes. -->
          <Grid VerticalAlignment="Center">
            <TextBlock Text="Click cards to select them" Opacity="0" IsHitTestVisible="False" />
            <TextBlock Text="{Binding PrimeGear.SelectionStatusText}" />
          </Grid>
          <StackPanel Classes="button-group joined">
            <Button Content="Select all" Command="{Binding PrimeGear.SelectAllCommand}" />
            <Button Content="Select none" Command="{Binding PrimeGear.SelectNoneCommand}" />
          </StackPanel>
          <!-- Unmark owned only applies to owned cards, which are selectable only while
               Show owned gear is on. The pair is joined only while both are visible
               (joined corners are chosen by position, which counts hidden children);
               otherwise Mark owned stands alone as a normal pill. -->
          <StackPanel
              Classes="button-group"
              Classes.joined="{Binding PrimeGear.ShowOwned}">
            <Button Content="Mark owned" Command="{Binding PrimeGear.MarkSelectedOwnedCommand}" />
            <Button
                Content="Unmark owned"
                Command="{Binding PrimeGear.UnmarkSelectedCommand}"
                IsVisible="{Binding PrimeGear.ShowOwned}" />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>

    <!-- Scrolling card area: fills the remaining space below the docked control panel. -->
    <ScrollViewer>
      <StackPanel>

      <!-- In-content busy indicator: shows which view is reloading. -->
      <TextBlock
          Margin="8,0,8,8"
          Text="Updating…"
          Opacity="0.7"
          FontStyle="Italic"
          IsVisible="{Binding PrimeGear.IsBusy}" />

      <!-- Empty-state: shown when a search is active but no card title matches. -->
      <TextBlock
          Margin="8,0,8,8"
          Text="No gear matches your search."
          Opacity="0.7"
          FontStyle="Italic"
          IsVisible="{Binding PrimeGear.HasNoSearchResults}" />

      <!-- Active gear section -->
      <ItemsControl
          ItemsSource="{Binding PrimeGear.ActiveCards}"
          ItemTemplate="{StaticResource GearCardTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <!-- Vaulted section header -->
      <Border
          Margin="8,8,8,0"
          Padding="12,8"
          Background="{DynamicResource ControlBarBackgroundBrush}"
          CornerRadius="4"
          IsVisible="{Binding PrimeGear.ShowVaulted}">
        <TextBlock FontWeight="SemiBold" Text="Vaulted" />
      </Border>

      <!-- Vaulted gear section -->
      <ItemsControl
          ItemsSource="{Binding PrimeGear.VaultedCards}"
          ItemTemplate="{StaticResource GearCardTemplate}"
          IsVisible="{Binding PrimeGear.ShowVaulted}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
