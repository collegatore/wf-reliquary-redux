<Window
    x:Class="WF.Reliquary.Presentation.RecruitingMessageDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WF.Reliquary.Presentation"
    Width="420"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    Title="Compose Recruiting Chat message"
    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="20">
    <StackPanel Spacing="12">

      <!-- Pattern -->
      <StackPanel Spacing="4">
        <TextBlock Foreground="Gray" Text="Pattern:" />
        <TextBlock
            FontFamily="Consolas,Monospace"
            Text="{Binding Pattern}"
            TextWrapping="Wrap" />
      </StackPanel>

      <Separator />

      <!-- Per-group selectors -->
      <ItemsControl ItemsSource="{Binding Selectors}" Grid.IsSharedSizeScope="True">
        <ItemsControl.ItemTemplate>
          <DataTemplate DataType="{x:Type local:RecruitingMessageSelectorViewModel}">
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" SharedSizeGroup="LabelCol" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <TextBlock
                  Grid.Column="0"
                  Text="{Binding Label}"
                  VerticalAlignment="Center" />
              <ComboBox
                  Grid.Column="2"
                  HorizontalAlignment="Stretch"
                  ItemsSource="{Binding Options}"
                  SelectedItem="{Binding SelectedOption, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding Descriptor}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Preview -->
      <Separator />
      <StackPanel Spacing="4">
        <TextBlock Foreground="Gray" Text="Preview:" />
        <SelectableTextBlock
            FontFamily="Consolas,Monospace"
            Text="{Binding Preview}"
            TextWrapping="Wrap" />
      </StackPanel>

    </StackPanel>

    <!-- Buttons -->
    <StackPanel
        Grid.Row="1"
        Margin="0,16,0,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal"
        Spacing="8">
      <Button
          Padding="14,6"
          Command="{Binding CopyCommand}"
          Content="📋 Copy" />
      <Button
          x:Name="CloseButton"
          Padding="14,6"
          Content="Close" />
    </StackPanel>
  </Grid>
</Window>
