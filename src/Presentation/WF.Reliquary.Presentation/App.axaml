<Application
    x:Class="WF.Reliquary.Presentation.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Styles>
    <FluentTheme />
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource ContentFontSize}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="{DynamicResource ContentFontSize}" />
    </Style>
  </Application.Styles>
  <Application.Resources>
    <x:Double x:Key="FontSizeSmall">11</x:Double>
    <x:Double x:Key="FontSizeMedium">14</x:Double>
    <x:Double x:Key="FontSizeLarge">18</x:Double>
    <!-- ContentFontSize is overwritten at runtime; Medium is the startup default -->
    <x:Double x:Key="ContentFontSize">14</x:Double>

    <!-- Card widths track the font size at runtime (see SettingsViewModel.ApplyFontSize);
         these are the Medium-font anchors. RelicCardWidth's anchor is user-configurable
         (Settings -> Appearance -> Relic card width); MissionCardWidth's anchor is fixed.
         Relic cards are wide enough for the longest reward name to fit on a single line. -->
    <x:Double x:Key="RelicCardWidth">300</x:Double>
    <x:Double x:Key="MissionCardWidth">300</x:Double>

    <!-- Max display width for the profile/wishlist selector buttons and the footer
         profile name. Over-long names truncate with an ellipsis (and a hover tooltip);
         the footer reuses this so its name column matches the Settings selector width. -->
    <x:Double x:Key="NameDisplayMaxWidth">220</x:Double>

    <!-- Relic-card tier colors. Light-theme values; a future dark theme should swap
         these via Application.Resources ThemeDictionaries rather than changing markup.
         Tier identity lives in the per-tier bar color; the tier label is uniform
         (default text color, semi-bold — see the TextBlock.tier-label style). -->
    <SolidColorBrush x:Key="TierLabelBrush" Color="#000000" />
    <SolidColorBrush x:Key="TierCommonBrush" Color="#C0772E" />
    <SolidColorBrush x:Key="TierUncommonBrush" Color="#7C8A9A" />
    <SolidColorBrush x:Key="TierRareBrush" Color="#D4A017" />

    <!-- Owned-gear accent: an unintrusive muted green, used for the owned card outline
         and the owned ✓ marker so owned reads as a positive state distinct from vaulting. -->
    <SolidColorBrush x:Key="OwnedAccentBrush" Color="#5E9E6E" />
    <!-- Subtle wash applied to a card selected for group operations. -->
    <SolidColorBrush x:Key="CardSelectedBrush" Color="#332D7DC4" />
  </Application.Resources>
</Application>
