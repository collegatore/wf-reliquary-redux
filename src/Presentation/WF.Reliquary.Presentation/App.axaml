<Application
    x:Class="WF.Reliquary.Presentation.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:WF.Reliquary.Presentation">

  <!-- ═══════════════════════════════════════════════════════════════════════
       VERBATIM RELIC CARD TEMPLATE — application-scoped (not just the relics
       panel's) so the rewards modal (Table mode's rewards pictogram) can host the
       same card via a plain ContentControl with no duplicated markup.
       ═══════════════════════════════════════════════════════════════════════ -->
  <Application.DataTemplates>
    <DataTemplate DataType="{x:Type local:WishlistRelicCardViewModel}">
      <Border
          Margin="8"
          Padding="12"
          BorderBrush="Gray"
          BorderThickness="1"
          CornerRadius="4"
          Width="{DynamicResource RelicCardWidth}"
          Classes.vaulted="{Binding IsVaulted}">
        <StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
            <TextBlock
                Grid.Column="0"
                FontWeight="SemiBold"
                Text="{Binding RelicName}"
                TextWrapping="Wrap"
                VerticalAlignment="Center" />
            <Button
                Grid.Column="1"
                Margin="4,0,0,0"
                Padding="6,2"
                VerticalAlignment="Center"
                Background="Transparent"
                BorderThickness="0"
                FontWeight="Bold"
                Content="⋮">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedRight" HorizontalOffset="25" FlyoutPresenterClasses="app-menu">
                  <MenuItem
                      Header="Compose Recruiting Chat message…"
                      Command="{Binding ComposeCommand}" />
                </MenuFlyout>
              </Button.Flyout>
            </Button>
          </Grid>
          <ItemsControl ItemsSource="{Binding TierGroups}">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type local:WishlistRelicTierGroupViewModel}">
                <!-- Per-tier accent bar in the left gutter; color encodes the
                     tier and the bar spans the whole group (label + wrapped
                     reward lines), replacing per-group separators. -->
                <Border
                    Margin="0,0,0,8"
                    Padding="6,0,0,0"
                    BorderThickness="3,0,0,0"
                    Classes.tier-common="{Binding IsCommon}"
                    Classes.tier-uncommon="{Binding IsUncommon}"
                    Classes.tier-rare="{Binding IsRare}">
                  <StackPanel>
                    <TextBlock
                        Margin="0,0,0,2"
                        Classes="tier-label"
                        Text="{Binding TierName}" />
                    <!-- Reward names indented beneath the tier label so the
                         label stands out and the rewards read as its list. -->
                    <ItemsControl ItemsSource="{Binding Rewards}" Margin="12,0,0,0">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:WishlistRelicRewardViewModel}">
                          <TextBlock
                              Text="{Binding RewardName}"
                              TextWrapping="Wrap"
                              Classes.dimmed="{Binding IsDimmed}" />
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>
    </DataTemplate>
  </Application.DataTemplates>

  <Application.Styles>
    <FluentTheme />
    <!-- TreeDataGrid control theme (Table relic view mode). Must follow FluentTheme.
         The community fork keeps the original assembly name, so the avares path is
         unchanged from upstream. -->
    <StyleInclude Source="avares://Avalonia.Controls.TreeDataGrid/Themes/Fluent.axaml" />
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource ContentFontSize}" />
    </Style>
    <Style Selector="TextBox">
      <Setter Property="FontSize" Value="{DynamicResource ContentFontSize}" />
    </Style>
    <!-- Icons scale with the font size (IconSize); a class may override for a
         different size. Shapes come from Styles/Icons.axaml. -->
    <Style Selector="PathIcon">
      <Setter Property="Width" Value="{DynamicResource IconSize}" />
      <Setter Property="Height" Value="{DynamicResource IconSize}" />
    </Style>
    <!-- Table mode row actions: icons stay muted behind the row text and come to
         full strength on hover. -->
    <Style Selector="Button.table-action PathIcon">
      <Setter Property="Opacity" Value="0.6" />
    </Style>
    <Style Selector="Button.table-action:pointerover PathIcon">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <!-- Shared control-bar look; must follow the TextBlock font-size style above
         so section headings keep their larger size. -->
    <StyleInclude Source="/Styles/ControlBars.axaml" />
    <!-- App-wide dropdowns (ComboBoxes, selector popups) and card menus. -->
    <StyleInclude Source="/Styles/Dropdowns.axaml" />
  </Application.Styles>
  <Application.Resources>
    <ResourceDictionary>
    <!-- The active color palette (control bars, dropdowns, card menus, selection
         color). Linen at load; PaletteApplier replaces this single merged entry
         when the user picks another palette. Palette keys live only there. -->
    <ResourceDictionary.MergedDictionaries>
      <ResourceInclude Source="/Styles/Palettes/Linen.axaml" />
      <!-- Vector icons (PathIcon.Data); palette-independent. -->
      <ResourceInclude Source="/Styles/Icons.axaml" />
    </ResourceDictionary.MergedDictionaries>
    <x:Double x:Key="FontSizeSmall">11</x:Double>
    <x:Double x:Key="FontSizeMedium">14</x:Double>
    <x:Double x:Key="FontSizeLarge">18</x:Double>
    <!-- ContentFontSize is overwritten at runtime; Medium is the startup default -->
    <x:Double x:Key="ContentFontSize">14</x:Double>
    <!-- Control-bar section headings ("Relics", "Missions"); rescaled with the
         font size at runtime like the card widths below. Medium-font anchor. -->
    <x:Double x:Key="SectionHeadingFontSize">16</x:Double>
    <!-- Icon size (PathIcon style above); rescaled with the font size at runtime.
         Medium-font anchor. -->
    <x:Double x:Key="IconSize">16</x:Double>

    <!-- Card widths track the font size at runtime (see SettingsViewModel.ApplyFontSize);
         these are the Medium-font anchors. RelicCardWidth's anchor is user-configurable
         (Settings -> Appearance -> Relic card width); MissionCardWidth's anchor is fixed.
         Relic cards are wide enough for the longest reward name to fit on a single line. -->
    <x:Double x:Key="RelicCardWidth">300</x:Double>
    <x:Double x:Key="MissionCardWidth">300</x:Double>

    <!-- Max display width for the profile/wishlist selector buttons and the footer
         profile name. Over-long names truncate with an ellipsis (and a hover tooltip);
         the footer reuses this so its name column matches the Settings selector width. -->
    <x:Double x:Key="NameDisplayMaxWidth">220</x:Double>

    <!-- Relic-card tier colors. Light-theme values; a future dark theme should swap
         these via Application.Resources ThemeDictionaries rather than changing markup.
         Tier identity lives in the per-tier bar color; the tier label is uniform
         (default text color, semi-bold — see the TextBlock.tier-label style). -->
    <SolidColorBrush x:Key="TierLabelBrush" Color="#000000" />
    <SolidColorBrush x:Key="TierCommonBrush" Color="#C0772E" />
    <SolidColorBrush x:Key="TierUncommonBrush" Color="#7C8A9A" />
    <SolidColorBrush x:Key="TierRareBrush" Color="#D4A017" />

    <!-- Owned-gear accent: an unintrusive muted green, used for the owned card outline
         and the owned ✓ marker so owned reads as a positive state distinct from vaulting. -->
    <SolidColorBrush x:Key="OwnedAccentBrush" Color="#5E9E6E" />

    <!-- Destructive actions (Delete in the ⋮ actions menus) while pointed at. The
         same in every palette, so it isn't a palette key. -->
    <SolidColorBrush x:Key="DestructiveForegroundBrush" Color="#B3261E" />

    <!-- Highlighter-style wash behind wishlisted reward text in the Table mode
         rewards modal, so the wishlisted reward stands out against the rest of
         the (otherwise dimmed) reward list. -->
    <SolidColorBrush x:Key="WishlistHighlightBrush" Color="#40FFD54F" />
    </ResourceDictionary>
  </Application.Resources>
</Application>
