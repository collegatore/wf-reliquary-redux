<Window
    x:Class="WF.Reliquary.Presentation.WishlistNameDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="360"
    Height="140"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="20">
    <StackPanel Spacing="8">
      <TextBlock x:Name="PromptLabel" Text="Wishlist name:" />
      <TextBox x:Name="NameBox" />
    </StackPanel>
    <StackPanel
        Grid.Row="1"
        Margin="0,12,0,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal"
        Spacing="8">
      <Button
          x:Name="OkButton"
          Padding="14,6"
          Content="OK" />
      <Button
          x:Name="CancelButton"
          Padding="14,6"
          Content="Cancel" />
    </StackPanel>
  </Grid>
</Window>
