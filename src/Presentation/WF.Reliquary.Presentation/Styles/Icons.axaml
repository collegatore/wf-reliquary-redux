<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ═══════════════════════════════════════════════════════════════════════
       ICONS — vector shapes for PathIcon.Data, so icons don't depend on installed
       fonts or the emoji font. Paths are Material Design Icons (Pictogrammers,
       Apache-2.0, see NOTICE), 24×24 and fill-based: PathIcon fills them with its
       inherited Foreground, so they follow hover, disabled and palette colors.
       Size comes from the PathIcon style in App.axaml (IconSize).
       ═══════════════════════════════════════════════════════════════════════ -->

  <!-- Menus and actions -->
  <!-- mdi:dots-vertical -->
