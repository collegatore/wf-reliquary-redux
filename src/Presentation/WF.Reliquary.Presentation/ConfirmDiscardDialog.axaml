<Window
    x:Class="WF.Reliquary.Presentation.ConfirmDiscardDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Discard changes?"
    Width="360"
    Height="140"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="*,Auto" Margin="20">
    <TextBlock
        TextWrapping="Wrap"
        VerticalAlignment="Center"
        Text="You have unsaved changes. Discard them and go back?" />
    <StackPanel
        Grid.Row="1"
        Margin="0,12,0,0"
        HorizontalAlignment="Right"
        Orientation="Horizontal"
        Spacing="8">
      <Button
          x:Name="DiscardButton"
          Padding="14,6"
          Content="Discard" />
      <Button
          x:Name="CancelButton"
          Padding="14,6"
          Content="Cancel" />
    </StackPanel>
  </Grid>
</Window>
